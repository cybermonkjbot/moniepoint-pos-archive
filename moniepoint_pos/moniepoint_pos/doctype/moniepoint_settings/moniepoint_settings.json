{
  "doctype": "DocType",
  "name": "Moniepoint Settings",
  "module": "Moniepoint POS",
  "issingle": 1,
  "engine": "InnoDB",
  "field_order": [
    "enabled",
    "auth_method",
    "api_key",
    "client_id",
    "client_secret",
    "environment",
    "amount_units",
    "contract_confirmed",
    "webhook_secret"
  ],
  "fields": [
    {
      "fieldname": "enabled",
      "label": "Enabled",
      "fieldtype": "Check"
    },
    {
      "fieldname": "auth_method",
      "label": "Connection method",
      "fieldtype": "Select",
      "options": "API key\nClient credentials",
      "default": "API key"
    },
    {
      "fieldname": "api_key",
      "label": "API key",
      "fieldtype": "Password",
      "depends_on": "eval:doc.auth_method !== 'Client credentials'"
    },
    {
      "fieldname": "client_id",
      "label": "Client ID",
      "fieldtype": "Password",
      "depends_on": "eval:doc.auth_method === 'Client credentials'"
    },
    {
      "fieldname": "client_secret",
      "label": "Client key",
      "fieldtype": "Password",
      "depends_on": "eval:doc.auth_method === 'Client credentials'"
    },
    {
      "fieldname": "environment",
      "label": "Connection environment",
      "fieldtype": "Select",
      "options": "\nSandbox\nProduction",
      "depends_on": "eval:doc.auth_method === 'Client credentials'"
    },
    {
      "fieldname": "amount_units",
      "label": "Confirmed API amount units",
      "fieldtype": "Select",
      "options": "\nKobo\nNaira"
    },
    {
      "fieldname": "contract_confirmed",
      "label": "Amount units confirmed with Moniepoint",
      "fieldtype": "Check"
    },
    {
      "fieldname": "webhook_secret",
      "label": "Webhook signing secret",
      "fieldtype": "Password"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 0
    }
  ],
  "track_changes": 1
}
