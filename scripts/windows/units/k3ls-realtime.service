[Unit]
Description=K3LS realtime
After=k3ls-cache.service k3ls-queue.service
Requires=k3ls-cache.service k3ls-queue.service
PartOf=k3ls.target

[Service]
User=k3ls
WorkingDirectory=/opt/k3ls/project/bench
Environment=PATH=/opt/k3ls/bin:/opt/k3ls/runtime/node/bin:/usr/bin:/bin
ExecStart=/opt/k3ls/bin/bench socketio
Restart=always
RestartSec=5

[Install]
WantedBy=k3ls.target
